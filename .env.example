# Copy to .env.local and fill in. Never commit .env.local.
# Local dev works without these (local JSON store, console codes,
# static AI fallbacks). Production does NOT fall back: the app throws
# at boot when neither POSTGRES_URL nor DATABASE_URL is set, and
# checkout returns 503 without Lemon Squeezy keys.

# --- AI readings (OpenRouter) ---
# Get a key at https://openrouter.ai/keys (free models available)
OPENROUTER_API_KEY=
# Any OpenRouter :free model; see https://openrouter.ai/models (filter: free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Auth sessions ---
# Random 32+ char string. Generate: openssl rand -base64 32
AUTH_SECRET=
# NextAuth session secret (legacy name kept for compatibility; the app
# signs its own JWT cookies with AUTH_SECRET).
NEXTAUTH_SECRET=

# --- Database (Supabase Postgres, pooler) ---
# Supabase project -> Settings -> Database -> Connection string.
# App connections use the TRANSACTION pooler (port 6543, prepare:false,
# max:1 per serverless instance); pg_dump / migrations use the SESSION
# pooler (port 5432). The code validates the pooler host/port at import
# and throws on a misconfigured URL. Either variable works; set at
# least one in production.
DATABASE_URL=
POSTGRES_URL=

# --- Supabase Auth (browser OTP sign-in) ---
# Supabase project -> Settings -> API. The browser client uses the
# anon key for email OTP sign-in only (8-digit codes, 1h expiry);
# the app database connection uses the postgres role and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project -> Settings -> API -> JWT Secret. Used to verify
# Supabase-issued tokens server-side.
SUPABASE_JWT_SECRET=

# --- Email for sign-in codes (Resend) ---
# https://resend.com/api-keys. Without it (dev), codes print to the server console.
RESEND_API_KEY=
EMAIL_FROM=Sortes <noreply@sortes.resonantatlas.com>

# --- Payments (Lemon Squeezy) ---
# Settings -> API, Stores, Products -> Variants, Settings -> Webhooks
# (order_created AND order_refunded). Webhook URL:
# https://sortes.resonantatlas.com/api/webhooks/lemonsqueezy
# Without these, checkout returns 503 ("Checkout not configured").
# The webhook grants credits on order_created and revokes them on
# order_refunded; it is idempotent against duplicate deliveries.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PACK5=
LEMONSQUEEZY_VARIANT_PACK12=
LEMONSQUEEZY_VARIANT_PACK30=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Scheduled jobs (Vercel Cron) ---
# Random 32+ char string. Vercel Cron sends it as a Bearer <redacted> to
# /api/cron/winback (scheduled in vercel.json, daily 02:00 UTC).
CRON_SECRET=

# --- Analytics (Plausible, optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://sortes.resonantatlas.com
