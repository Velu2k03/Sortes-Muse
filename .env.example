# Copy to .env.local and fill in. Never commit .env.local.
# Local dev works without these (local JSON store, console codes,
# AI routes return an honest 503 with no spend). Production does NOT
# fall back: the app throws at boot when neither POSTGRES_URL nor
# DATABASE_URL is set, and checkout returns 503 without Lemon Squeezy keys.

# --- AI readings (OpenRouter) ---
# Get a key at https://openrouter.ai/keys (free models available)
OPENROUTER_API_KEY=
# Any OpenRouter :free model; see https://openrouter.ai/models (filter: free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Auth sessions ---
# Random 32+ char string. Generate: openssl rand -base64 32
# Fallback chain in src/lib/auth.ts: AUTH_SECRET, then NEXTAUTH_SECRET,
# then SUPABASE_JWT_SECRET. AUTH_SECRET is the preferred dedicated
# secret; the Supabase fallback exists so sessions work without a new
# secret, but sharing it means a Supabase secret rotation invalidates
# every Sortes session.
AUTH_SECRET=
# Legacy alias, second in the fallback chain. Not needed while
# SUPABASE_JWT_SECRET is set; do not add it to production.
NEXTAUTH_SECRET=

# --- Database (Supabase Postgres, pooler) ---
# Supabase project -> Settings -> Database -> Connection string.
# App connections use the TRANSACTION pooler (port 6543, prepare:false,
# max:1 per serverless instance); pg_dump / migrations use the SESSION
# pooler (port 5432). The code validates the pooler host/port at import
# and throws on a misconfigured URL. Either variable works; set
# exactly ONE in production (POSTGRES_URL is canonical). Setting both
# to different databases is a footgun: the app and the reconcile
# script both prefer POSTGRES_URL (Phase B, R13).
DATABASE_URL=
POSTGRES_URL=

# --- Supabase Auth (browser OTP sign-in) ---
# Supabase project -> Settings -> API. The browser client uses the
# anon key for email OTP sign-in only (8-digit codes, 1h expiry);
# the app database connection uses the postgres role and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project -> Settings -> API -> JWT Secret. Last resort in the
# session-secret fallback chain (src/lib/auth.ts): it signs Sortes' own
# session cookies when AUTH_SECRET / NEXTAUTH_SECRET are unset. It is
# NOT used to verify Supabase tokens (that goes through the anon-key
# client and getUser).
SUPABASE_JWT_SECRET=

# --- Email for sign-in codes (Resend) ---
# https://resend.com/api-keys. Without it (dev), codes print to the server console.
RESEND_API_KEY=
EMAIL_FROM=Sortes <noreply@sortes.resonantatlas.com>
# Local dev only: SORTES_LOCAL_DEV_CODE=1 lets request-code return
# the 6-digit sign-in code in the API response when no Resend key is
# set (Phase B, R11). NEVER set this on Vercel or in production: the
# dev path also requires NODE_ENV != production, but the flag itself
# must stay local-only. Without it, local sign-in without Resend
# returns 500.
SORTES_LOCAL_DEV_CODE=1

# --- Payments (Lemon Squeezy) ---
# Settings -> API, Stores, Products -> Variants, Settings -> Webhooks
# (order_created AND order_refunded). Webhook URL:
# https://sortes.resonantatlas.com/api/webhooks/lemonsqueezy
# Without these, checkout returns 503 ("Checkout not configured").
# The webhook grants credits on order_created and revokes them on
# order_refunded; it is idempotent against duplicate deliveries.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_PACK5=
LEMONSQUEEZY_VARIANT_PACK12=
LEMONSQUEEZY_VARIANT_PACK30=
LEMONSQUEEZY_WEBHOOK_SECRET=

# --- Scheduled jobs (Vercel Cron) ---
# Random 32+ char string. Vercel Cron sends it as a Bearer <redacted> to
# /api/cron/winback (scheduled in vercel.json, daily 02:00 UTC).
CRON_SECRET=

# --- Analytics (Plausible, optional) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://sortes.resonantatlas.com
